# ─────────────────────────────────────────────────────────────────
# CineStage — environment variable reference
#
# This file is safe to commit. It documents every variable the app
# needs without containing real values.
#
# HOW TO USE
#   Local dev  → copy to .env.local and fill in your values
#   Production → set these variables in your hosting dashboard
#                (Vercel / Railway / Render / Docker / etc.)
# ─────────────────────────────────────────────────────────────────

# ── Backend API base URL ──────────────────────────────────────────
# Next.js proxies all /api/* requests to this origin.
# Must NOT have a trailing slash.
# Examples:
#   http://localhost:8080          (local Spring Boot)
#   https://api.yourdomain.com     (production)
#   https://your-app.railway.app   (Railway deployment)
NEXT_PUBLIC_API_BASE_URL=

# ── Public app URL ────────────────────────────────────────────────
# Full URL where the frontend is hosted (no trailing slash).
# Used for absolute links, og:url, canonical tags.
NEXT_PUBLIC_APP_URL=

# ── App display name ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=CineStage

# ── Node environment ─────────────────────────────────────────────
# Automatically set by most platforms. Only set manually if needed.
# Values: development | production | test
NODE_ENV=production

# ── Show schedule anchor ──────────────────────────────────────────
# The ISO date (YYYY-MM-DD) of the first day shows are available
# in the database. The date-strip labels "Today" and "Tomorrow"
# are pinned to this date and the day after, regardless of the
# real calendar date.
# Example: 2026-09-23   (Wednesday — first show date in the DB)
# Leave blank to use the real current date instead.
NEXT_PUBLIC_SHOW_START_DATE=
